# Копирайте този файл като .env и попълнете каквото ви трябва.
# Без .env магазинът работи с настройките по подразбиране.

PORT=5200
# Къде се пазят базата (shop.db) и качените снимки (uploads/)
DATA_DIR=./data
# Примерни калъфи и профили demo-buyer / demo-seller при празна база
SEED_DEMO=true
# true, ако сървърът е зад reverse proxy (nginx, Render, Railway…) с HTTPS
TRUST_PROXY=false

# Имейл до продавачите при нова заявка за калъф (по желание).
# Без тези настройки заявките се виждат само в панела на продавача.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
